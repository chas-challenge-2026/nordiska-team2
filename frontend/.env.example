# =====================================================================
# FRONTEND CONFIGURATION TEMPLATE (frontend/.env.example)
#
# Copy this file to 'frontend/.env' before running Vite:
#   cp frontend/.env.example frontend/.env (or Copy-Item in PowerShell)
#
# NOTE: VITE_* variables are public and bundled into the browser client.
# =====================================================================

# Backend API base URL
# - Use http://localhost:8080/api when running backend with Docker Compose
# - Use http://localhost:5063/api when running backend locally via 'dotnet run'
VITE_API_BASE_URL=http://localhost:8080/api
