# =====================================================================
# LOCAL DEVELOPMENT ENVIRONMENT TEMPLATE (infra/.env.example)
#
# Copy this file to 'infra/.env' before running docker compose:
#   cp infra/.env.example infra/.env (or Copy-Item in PowerShell)
#
# NOTE: Real production and staging secrets are NEVER committed to git.
# In staging/production, these variables are injected by the hosting
# server/platform environment.
# =====================================================================

# PostgreSQL password for the local container (matches POSTGRES_PASSWORD in docker-compose.yml)
DB_PASSWORD=nordiska123

# Secret key used for signing JWT tokens in local development (minimum 32 characters)
# For production, generate a secure random 64-char hex key (e.g. 'openssl rand -hex 32')
JWT_KEY=dev_jwt_secret_key_minimum_32_characters_for_local_testing_only_123456

# Allowed origin for CORS in local development (matches Vite development server)
CORS_ORIGIN=http://localhost:5173
