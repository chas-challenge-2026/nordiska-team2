VALGRIND_FLAGS := ""
ASAN_OPTIONS := "symbolize=1:detect_leaks=1"
GDB_FLAGS := "-q"

default:
    @just --list

configure:
    cmake --preset default

configure-asan:
    cmake --preset asan

build: configure
    cmake --build --preset default

build-asan: configure-asan
    cmake --build --preset asan

generate-cert:
	mkdir -p data
	openssl req -x509 -newkey rsa:2048 -keyout /tmp/key.pem -out /tmp/cert.pem -days 365 -nodes \
		-subj "/C=SE/O=Nordiska/OU=Document Signing Authority/CN=Nordiska Signing Services/emailAddress=signatures@nordiska.se" \
		-addext "basicConstraints=critical,CA:FALSE" \
		-addext "keyUsage=critical,digitalSignature,nonRepudiation" \
		-addext "extendedKeyUsage=codeSigning,emailProtection,1.3.6.1.5.5.7.3.4" 2>/dev/null
	openssl pkcs12 -export -out data/test_cert.pfx -inkey /tmp/key.pem -in /tmp/cert.pem -name "Nordiska Document Signing" -passout pass:secret123 2>/dev/null
	rm /tmp/key.pem /tmp/cert.pem

generate-mock: generate-cert
    python3 scripts/generate_mock_json.py 1000 data/mock_tax_report_1k.json
    python3 scripts/generate_mock_json.py 5 data/mock_tax_report_5.json

run name="generate_tax_reports_example" *args="": build generate-mock
    @if [ -f "build/default/examples/{{ name }}" ]; then \
        ./build/default/examples/{{ name }} {{ args }}; \
    else \
        echo "Error: Binary '{{ name }}' not found in examples/"; exit 1; \
    fi

test: build
    ctest --test-dir build/default --output-on-failure

# Configure CMake with benchmarks enabled
configure-bench:
    cmake --preset default -DBUILD_BENCHMARKS=ON

bench: generate-mock
    cmake --preset default -DBUILD_BENCHMARKS=ON
    cmake --build --preset default --target bench_pdf_batch
    ./build/default/benches/bench_pdf_batch

# Builds with ASan preset and executes target binary
asan name="generate_tax_reports_example" *args="": build-asan generate-mock
    @if [ -f "build/asan/examples/{{ name }}" ]; then \
        ASAN_OPTIONS={{ quote(ASAN_OPTIONS) }} ./build/asan/examples/{{ name }} {{ args }}; \
    else \
        echo "Error: Binary '{{ name }}' not found in build/asan/examples/"; exit 1; \
    fi

# Runs GDB debugger on the default debug binary
gdb name="generate_tax_reports_example" *args="": build generate-mock
    @if [ -f "build/default/examples/{{ name }}" ]; then \
        gdb {{ GDB_FLAGS }} --args ./build/default/examples/{{ name }} {{ args }}; \
    else \
        echo "Error: Binary '{{ name }}' not found in examples/"; exit 1; \
    fi

# Runs valgrind on the target binary
valgrind name="generate_tax_reports_example" *args="": build generate-mock
    @if [ -f "build/default/examples/{{ name }}" ]; then \
        valgrind --leak-check=full --error-exitcode=1 {{ VALGRIND_FLAGS }} ./build/default/examples/{{ name }} {{ args }}; \
    else \
        echo "Error: Binary '{{ name }}' not found in examples/"; exit 1; \
    fi

# Runs valgrind with comprehensive memory checking
valgrind-all name="generate_tax_reports_example" *args="": build
    @if [ -f "build/default/examples/{{ name }}" ]; then \
        valgrind --leak-check=full --show-leak-kinds=all --show-reachable=yes --track-origins=yes --error-exitcode=1 {{ VALGRIND_FLAGS }} ./build/default/examples/{{ name }} {{ args }}; \
    else \
        echo "Error: Binary '{{ name }}' not found in examples/"; exit 1; \
    fi

docs: build
    cmake --build --preset default --target docs
    xdg-open build/default/docs/html/index.html

# Directories (relative to native/) to exclude from formatting — e.g. vendored code.
# Leave empty to format everything git tracks.
fmt_exclude := ""

_fmt_pathspec:
    #!/usr/bin/env bash
    set -euo pipefail
    pathspec=('*.c' '*.h')
    for dir in {{fmt_exclude}}; do
        pathspec+=(":(exclude)${dir}/*")
    done
    git ls-files -z -- "${pathspec[@]}"

fmt:
    just _fmt_pathspec | xargs -0 -r clang-format -i

fmt-check:
    just _fmt_pathspec | xargs -0 -r clang-format --dry-run --Werror

# Run static analysis
lint:
    cmake --preset default -DPDF_ENGINE_CLANG_TIDY=ON
    cmake --build --preset default --clean-first --target pdf_engine

clean:
    rm -rf build/
    rm -rf data/

