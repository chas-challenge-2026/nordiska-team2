default:
    @just --list

configure:
    cmake --preset default

configure-asan:
    cmake --preset asan

build: configure
    cmake --build --preset default

# Parameterized run command for examples/tools
run example name *args="": build
    @if [ -f "build/default/examples/{{ name }}" ]; then \
        ./build/default/examples/{{ name }} {{ args }}; \
    else \
        echo "Error: Binary '{{ name }}' not found in examples/"; exit 1; \
    fi

test: build
    cmake --build --preset default
    ctest --test-dir build/default --output-on-failure

# Configure CMake with benchmarks enabled
configure-bench:
    cmake --preset default -DBUILD_BENCHMARKS=ON

bench: generate-cert
    cmake --preset default -DBUILD_BENCHMARKS=ON
    cmake --build --preset default --target bench_pdf_batch
    ./build/default/benches/bench_pdf_batch

valgrind *ARGS:
    cmake --preset default
    cmake --build --preset default
    bash -c 'ARGS=({{ARGS}}); TARGET="pdf_stress_test"; VALGRIND_ARGS=(); if [ ${#ARGS[@]} -gt 0 ] && [[ "${ARGS[0]}" != -* ]]; then TARGET="${ARGS[0]}"; VALGRIND_ARGS=("${ARGS[@]:1}"); else VALGRIND_ARGS=("${ARGS[@]}"); fi; cmake --build --preset default --target "$TARGET"; valgrind --leak-check=full --error-exitcode=1 "${VALGRIND_ARGS[@]}" ./build/default/examples/"$TARGET"'

valgrind-all:
    just valgrind --show-reachable=yes --track-origins=yes --leak-check=full --show-leak-kinds=all

docs: build
    cmake --build --preset default --target docs
    xdg-open build/default/docs/html/index.html

# Automatically format all C source and header files
fmt:
    clang-format -i $(find src include tests -name '*.c' -o -name '*.h')

# Check formatting without modifying files (exits 1 on error for CI)
fmt-check:
    clang-format --dry-run --Werror $(find src include tests -name '*.c' -o -name '*.h')

# Run static analysis (requires compile_commands.json from CMake)
lint: configure
    clang-tidy -p build/default $(find src -name '*.c')
    ln -sf build/default/compile_commands.json .

clean:
    rm -rf build/

generate-cert:
    mkdir -p data
    openssl req -x509 -newkey rsa:2048 -keyout /tmp/key.pem -out /tmp/cert.pem -days 1 -nodes -subj "/CN=Test" 2>/dev/null
    openssl pkcs12 -export -out data/test_cert.pfx -inkey /tmp/key.pem -in /tmp/cert.pem -passout pass:secret123 2>/dev/null
    rm /tmp/key.pem /tmp/cert.pem
